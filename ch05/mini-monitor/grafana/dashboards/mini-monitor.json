  {
   "type": "timeseries",
   "title": "적재 점/초 · 수집 방식",
   "description": "push 에이전트가 보낸 것과 pull 수집기가 당겨 온 것. 적재량은 저장소 내부 지표라 TimescaleDB 직접",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "timescaledb"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT $__timeGroupAlias(time, '10s'), labels->>'via' AS metric, count(*) / 10.0 AS value\nFROM metrics WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "options": {
