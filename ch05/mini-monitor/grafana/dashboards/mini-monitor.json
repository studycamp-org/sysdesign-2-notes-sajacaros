  {
   "type": "table",
   "title": "청크",
   "description": "10분마다 새 청크. 15분 지나면 압축 정책이 컬럼형으로 바꾸고, 6시간 지나면 통째로 지운다",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "timescaledb"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT c.chunk_name AS \"청크\", c.range_start AS \"시작\", c.range_end AS \"끝\",\n       CASE WHEN c.is_compressed THEN '압축됨' ELSE '원본' END AS \"상태\",\n       s.total_bytes AS \"크기\"\nFROM timescaledb_information.chunks c\nJOIN chunks_detailed_size('metrics') s ON s.chunk_name = c.chunk_name\nWHERE c.hypertable_name = 'metrics' ORDER BY c.range_start DESC"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "크기"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     }
    ]
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "timescaledb"
   },
   "gridPos": {
    "x": 14,
    "y": 42,
    "w": 10,
    "h": 9
   },
